# Copy to .env and set your own values (.env is not committed).
POSTGRES_USER=eda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eda
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Pages that may call the API from a browser (the Vite dev server, and a phone/tablet on the same Wi-Fi).
CORS_ORIGINS=["http://localhost:5173"]

# Signs the login cookie: a long random string (at least 32 characters), different on every installation and kept secret.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# true where the site is served over HTTPS (the login cookie is then sent only over it)
SESSION_COOKIE_SECURE=false
